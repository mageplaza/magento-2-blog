use Mageplaza\Blog\Block\MonthlyArchive\Widget;
use Magento\Framework\Escaper;

/** @var Widget $block */
/** @var Escaper $escaper */
$archiveItems = $block->getMonthlyArchiveItems();

if ($block->isEnable() && $archiveItems) : ?>
    <div class="mp-sidebar mpcss">
        <div class="row">
            <div class="block-title col-xs-12 sidebar-archives">
                <p class="block-mp-sidebar-heading" role="heading"
                   aria-level="2"><?= $escaper->escapeHtml(__('Monthly Archive')) ?></p>
            </div>
            <div class="col-xs-12">
                <ul class="menu-archives">
                    <?php foreach ($archiveItems as $item) : ?>
                        <li class="archive-item">
                            <a class="list-archives"
                               href="<?= $escaper->escapeUrl($item['url']) ?>">
                                <i class="fa fa-calendar" aria-hidden="true"></i>&nbsp;&nbsp;
                                <?= $escaper->escapeHtml($item['label'] . '   (' . $item['count'] . ')') ?>
                            </a>
                        </li>
                    <?php endforeach; ?>
                </ul>
            </div>
        </div>
    </div>
<?php endif; ?>
