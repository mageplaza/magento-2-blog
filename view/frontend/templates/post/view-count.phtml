use Mageplaza\Blog\Block\Post\View;

/** @var View $block */
$_post  = $block->getPost();
$postId = $_post ? (int) $_post->getId() : 0;
$viewCounterConfig = json_encode([
    'postId' => $postId,
    'url'    => $block->getUrl('mpblog/post/updateview'),
]);
?>
<?php if ($postId): ?>
<script type="text/x-magento-init">
    {
        "*": {
            "Mageplaza_Blog/js/view-counter": <?= /* @noEscape */ $viewCounterConfig ?>
        }
    }
</script>
<?php endif; ?>
