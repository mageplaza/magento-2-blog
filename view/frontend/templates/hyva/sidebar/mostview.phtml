use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HeroiconsOutline;
use Mageplaza\Blog\Block\Sidebar\MostView;
use Magento\Framework\Escaper;

/** @var MostView $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

$heroicons   = $viewModels->require(HeroiconsOutline::class);
$popular     = $block->getMostViewPosts()->getItems();
$recent      = $block->getRecentPost()->getItems();
$tabClass    = 'flex-1 px-3 py-2 text-sm font-semibold text-slate-500 border-b-2 border-transparent '
    . 'hover:text-primary aria-selected:text-primary aria-selected:border-primary';
$renderPosts = function (array $posts) use ($block, $escaper, $heroicons): string {
    if (!$posts) {
        return '<p class="py-3 text-center text-sm text-slate-500">' . $escaper->escapeHtml(__('No Posts')) . '</p>';
    }
    $html = '';
    foreach ($posts as $post) {
        $html .= '<a class="blog-subcard" href="' . $escaper->escapeUrl($post->getUrl()) . '">';
        if ($post->getImage()) {
            $html .= '<span class="blog-subcard__media"><img src="'
                . $escaper->escapeUrl($block->resizeImage($post->getImage(), '160x'))
                . '" alt="' . $escaper->escapeHtmlAttr($post->getName()) . '" loading="lazy"/></span>';
        }
        $html .= '<span class="blog-subcard__body"><span class="blog-subcard__title">'
            . $escaper->escapeHtml($post->getName()) . '</span>';
        if ($post->getPublishDate()) {
            $html .= '<span class="blog-subcard__date">'
                . $escaper->escapeHtml($block->getDateFormat($post->getPublishDate())) . '</span>';
        }
        $html .= '<span class="blog-subcard__more">' . $escaper->escapeHtml(__('Read More'))
            . $heroicons->arrowRightHtml('', 14, 14, ['aria-hidden' => 'true']) . '</span>';
        $html .= '</span></a>';
    }

    return $html;
};
?>
<section class="sidebar-widget" x-data="blogSidebarTabs">
    <div class="flex border-b border-slate-200 mb-2" role="tablist" aria-label="<?= $escaper->escapeHtmlAttr(__('Posts')) ?>">
        <button type="button"
                role="tab"
                id="mpblog-tab-popular"
                aria-controls="mpblog-tabpanel-popular"
                aria-selected="true"
                :aria-selected="popularActive"
                class="<?= $escaper->escapeHtmlAttr($tabClass) ?>"
                @click="showPopular"
                @keydown.right.prevent="showLatest"><?= $escaper->escapeHtml(__('Popular')) ?></button>
        <button type="button"
                role="tab"
                id="mpblog-tab-latest"
                aria-controls="mpblog-tabpanel-latest"
                aria-selected="false"
                :aria-selected="latestActive"
                class="<?= $escaper->escapeHtmlAttr($tabClass) ?>"
                @click="showLatest"
                @keydown.left.prevent="showPopular"><?= $escaper->escapeHtml(__('Latest')) ?></button>
    </div>
    <div id="mpblog-tabpanel-popular"
         role="tabpanel"
         aria-labelledby="mpblog-tab-popular"
         x-show="popularActive">
        <?= /** @noEscape */ $renderPosts($popular) ?>
    </div>
    <div id="mpblog-tabpanel-latest"
         role="tabpanel"
         aria-labelledby="mpblog-tab-latest"
         x-show="latestActive"
         x-cloak>
        <?= /** @noEscape */ $renderPosts($recent) ?>
    </div>
</section>
<script src="<?= $escaper->escapeUrl($block->getViewFileUrl('Mageplaza_Blog::js/hyva/sidebar-tabs.js')) ?>" defer></script>
