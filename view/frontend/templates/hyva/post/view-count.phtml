use Mageplaza\Blog\Block\Post\View;
use Magento\Framework\Escaper;

/** @var View $block */
/** @var Escaper $escaper */
$_post  = $block->getPost();
$postId = $_post ? (int) $_post->getId() : 0;
$viewCounterConfig = [
    'postId' => $postId,
    'url'    => $block->getUrl('mpblog/post/updateview'),
];
?>
<?php if ($postId): ?>
<script type="application/json" id="mpblog-view-counter-config"><?= /* @noEscape */ json_encode($viewCounterConfig, JSON_HEX_TAG | JSON_HEX_AMP) ?></script>
<script src="<?= $escaper->escapeUrl($block->getViewFileUrl('Mageplaza_Blog::js/hyva/view-counter.js')) ?>" defer></script>
<?php endif; ?>
