use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HeroiconsOutline;
use Mageplaza\Blog\Block\Post\View;
use Mageplaza\Blog\Helper\Data as BlogHelper;

/** @var View $block */
/** @var \Magento\Framework\Escaper $escaper */
/** @var ViewModelRegistry $viewModels */
/** @var HeroiconsOutline $heroicons */
$heroicons = $viewModels->require(HeroiconsOutline::class);

$_post       = $block->getPost();
$helper      = $block->helperData;
$categoryIds = $_post->getCategoryIds();
$categories  = $categoryIds ? $helper->getCategoryCollection($categoryIds) : [];
$maximum     = (int) $helper->getSidebarConfig('categories/maximum');

$links = [];
$shown = 0;
foreach ($categories as $_cat) {
    if ($maximum && $shown >= $maximum) {
        break;
    }
    $shown++;
    $links[] = '<a href="' . $escaper->escapeUrl($helper->getBlogUrl($_cat, BlogHelper::TYPE_CATEGORY)) . '">'
        . $escaper->escapeHtml($_cat->getName()) . '</a>';
}
?>
<?php if ($links) : ?>
    <span class="blog-meta__item">
        <?= $heroicons->folderHtml('', 14, 14, ['aria-hidden' => 'true']) ?>
        <span class="blog-post-info__categories"><?= /** @noEscape */ implode(', ', $links) ?></span>
    </span>
<?php endif; ?>
