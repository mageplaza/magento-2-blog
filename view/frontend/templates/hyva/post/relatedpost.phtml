use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HeroiconsOutline;
use Mageplaza\Blog\Block\Post\RelatedPost;
use Magento\Framework\Escaper;

/** @var RelatedPost $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

/** @var HeroiconsOutline $heroicons */
$heroicons = $viewModels->require(HeroiconsOutline::class);

$posts = $block->getRelatedPostList();

// getRelatedMode() returns true for SLIDER (blog/post_view_page/related_mode === 1) — Block/Post/View.php:71
$isSlider = (bool) $block->getRelatedMode();

$renderCard = static function ($post) use ($escaper, $block) {
    ?>
    <article class="blog-card">
        <a href="<?= $escaper->escapeUrl($post->getUrl()) ?>" class="blog-card-media">
            <?php if ($post->getImage()) : ?>
                <img src="<?= $escaper->escapeUrl($block->resizeImage($post->getImage(), '400x250')) ?>"
                     alt="<?= $escaper->escapeHtmlAttr($post->getName()) ?>" loading="lazy"/>
            <?php endif; ?>
        </a>
        <div class="blog-card-body">
            <h3 class="blog-card-title">
                <a href="<?= $escaper->escapeUrl($post->getUrl()) ?>"
                   title="<?= $escaper->escapeHtmlAttr($post->getName()) ?>">
                    <?= $escaper->escapeHtml($post->getName()) ?>
                </a>
            </h3>
        </div>
    </article>
    <?php
};
?>
<?php if ($posts && $block->isEnabledBlog()) : ?>
    <section class="blog-section"<?= $posts->getSize() && $isSlider ? ' x-data x-snap-slider.group-pager x-defer="intersect"' : '' ?>>
        <header class="blog-section-header">
            <h2 class="blog-section-title">
                <?= $posts->getSize()
                    ? $escaper->escapeHtml(__('Related Posts'))
                    : $escaper->escapeHtml(__('No Related Posts')) ?>
            </h2>
        </header>

        <?php if ($posts->getSize()) : ?>
            <?php if ($isSlider) : ?>
                <div class="relative">
                    <div class="snap-track sm:[--snap-cols:2] lg:[--snap-cols:3]"
                         data-track tabindex="0" aria-live="polite">
                        <?php foreach ($posts as $post) : ?>
                            <?php $renderCard($post); ?>
                        <?php endforeach; ?>
                    </div>
                    <button type="button" class="blog-snap-arrow blog-snap-arrow--prev" data-prev disabled
                            aria-label="<?= $escaper->escapeHtmlAttr(__('Previous')) ?>">
                        <?= $heroicons->chevronLeftHtml('', 20, 20, ['aria-hidden' => 'true']) ?>
                    </button>
                    <button type="button" class="blog-snap-arrow blog-snap-arrow--next" data-next disabled
                            aria-label="<?= $escaper->escapeHtmlAttr(__('Next')) ?>">
                        <?= $heroicons->chevronRightHtml('', 20, 20, ['aria-hidden' => 'true']) ?>
                    </button>
                </div>
                <div class="snap-pager" data-pager></div>
            <?php else : ?>
                <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
                    <?php foreach ($posts as $post) : ?>
                        <?php $renderCard($post); ?>
                    <?php endforeach; ?>
                </div>
            <?php endif; ?>
        <?php endif; ?>
    </section>
<?php endif; ?>
