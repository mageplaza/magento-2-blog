use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HeroiconsOutline;
use Magento\Catalog\Block\Product\ReviewRendererInterface;
use Magento\Framework\App\Action\Action;
use Mageplaza\Blog\Block\Post\RelatedProduct;
use Magento\Framework\Escaper;

/** @var RelatedProduct $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

/** @var HeroiconsOutline $heroicons */
$heroicons = $viewModels->require(HeroiconsOutline::class);

$collection = $block->getLoadedProductCollection();
$isSlider   = $block->relatedMode() === '1';
$imageArea  = 'category_page_grid';

$renderCard = static function ($product) use ($block, $escaper, $imageArea) {
    $url = $block->getParentProductUrl($product);
    ?>
    <div class="blog-product-card">
        <a href="<?= $escaper->escapeUrl($url) ?>" class="blog-product-card__media" tabindex="-1">
            <?= $block->getImage($product, $imageArea)->toHtml() ?>
        </a>
        <div class="blog-product-card__body">
            <a class="blog-product-card__name" href="<?= $escaper->escapeUrl($url) ?>">
                <?= $escaper->escapeHtml($product->getName()) ?>
            </a>
            <?= $block->getReviewsSummaryHtml($product, ReviewRendererInterface::SHORT_VIEW) ?>
            <div class="blog-product-card__price">
                <?= /** @noEscape */ $block->getProductPrice($product) ?>
            </div>
            <?php if ($product->isSaleable()) : ?>
                <?php $postParams = $block->getAddToCartPostParams($product); ?>
                <form data-role="tocart-form"
                      action="<?= $escaper->escapeUrl($postParams['action']) ?>" method="post">
                    <input type="hidden" name="product" value="<?= $escaper->escapeHtmlAttr($postParams['data']['product']) ?>"/>
                    <input type="hidden" name="<?= /* @noEscape */ Action::PARAM_NAME_URL_ENCODED ?>"
                           value="<?= $escaper->escapeHtmlAttr($postParams['data'][Action::PARAM_NAME_URL_ENCODED]) ?>"/>
                    <?= $block->getBlockHtml('formkey') ?>
                    <button type="submit" class="blog-product-card__btn"
                            title="<?= $escaper->escapeHtmlAttr(__('Add to Cart')) ?>">
                        <?= $escaper->escapeHtml(__('Add to Cart')) ?>
                    </button>
                </form>
            <?php endif; ?>
        </div>
    </div>
    <?php
};
?>
<?php if (!$collection->count()) : ?>
    <div class="blog-empty">
        <?= $escaper->escapeHtml(__('We can\'t find products matching the selection.')) ?>
    </div>
<?php elseif ($isSlider) : ?>
    <div class="blog-products-slider" x-data x-snap-slider.group-pager x-defer="intersect">
        <div class="relative">
            <div class="snap-track sm:[--snap-cols:2] lg:[--snap-cols:3] xl:[--snap-cols:4]"
                 data-track tabindex="0" aria-live="polite">
                <?php foreach ($collection as $product) : ?>
                    <?php $renderCard($product); ?>
                <?php endforeach; ?>
            </div>
            <button type="button" class="blog-snap-arrow blog-snap-arrow--prev" data-prev disabled
                    aria-label="<?= $escaper->escapeHtmlAttr(__('Previous')) ?>">
                <?= $heroicons->chevronLeftHtml('', 20, 20, ['aria-hidden' => 'true']) ?>
            </button>
            <button type="button" class="blog-snap-arrow blog-snap-arrow--next" data-next disabled
                    aria-label="<?= $escaper->escapeHtmlAttr(__('Next')) ?>">
                <?= $heroicons->chevronRightHtml('', 20, 20, ['aria-hidden' => 'true']) ?>
            </button>
        </div>
        <div class="snap-pager" data-pager></div>
    </div>
<?php else : ?>
    <div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4">
        <?php foreach ($collection as $product) : ?>
            <?php $renderCard($product); ?>
        <?php endforeach; ?>
    </div>
<?php endif; ?>
