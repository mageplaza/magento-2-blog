use Hyva\Theme\ViewModel\HyvaCsp;
use Mageplaza\Blog\Block\Author\SignupForm;
use Magento\Framework\Escaper;

/** @var SignupForm $block */
/** @var Escaper $escaper */
/** @var HyvaCsp $hyvaCsp */
$author    = $block->getAuthor();
$isNew     = $author['name'] === '';
$submitTxt = $isNew ? __('Submit') : __('Save');
?>
<form enctype="multipart/form-data"
      action="<?= $escaper->escapeUrl($block->getUrl('mpblog/author/register')) ?>" method="post"
      name="mp_blog_author_form" id="blog_signup_author"
      class="form w-full"
      x-data="hyva.formValidation" @submit="onSubmit" novalidate>
    <?= /* @noEscape */ $block->getBlockHtml('formkey'); ?>

    <fieldset class="fieldset">
        <legend class="legend">
            <span><?= $escaper->escapeHtml($isNew ? __('Signup Author') : __('Author Information')) ?></span>
        </legend>

        <div class="field field-reserved required">
            <label class="label" for="name"><span><?= $escaper->escapeHtml(__('Display Name')) ?></span></label>
            <div class="control">
                <input type="text" name="name" id="name" class="form-input w-full"
                       value="<?= $escaper->escapeHtmlAttr($author['name']) ?>"
                       title="<?= $escaper->escapeHtmlAttr(__('Display Name')) ?>"
                       required data-validate='{"required": true}'/>
            </div>
        </div>

        <?php if (isset($author['status'])): ?>
            <div class="field">
                <label class="label"><span><?= $escaper->escapeHtml(__('Status')) ?></span></label>
                <div class="control"><span><?= $escaper->escapeHtml($author['status']) ?></span></div>
            </div>
        <?php endif; ?>

        <div class="field">
            <label class="label" for="short_description"><span><?= $escaper->escapeHtml(__('Short Description')) ?></span></label>
            <div class="control">
                <textarea name="short_description" id="short_description" class="form-input w-full" rows="5"><?= /* @noEscape */
                    $author['short_description'] ? $block->getPageFilter($author['short_description']) : '' ?></textarea>
            </div>
        </div>

        <div class="field">
            <label class="label" for="image"><span><?= $escaper->escapeHtml(__('Avatar')) ?></span></label>
            <div class="control">
                <?php if (!empty($author['image'])): ?>
                    <a class="inline-block mb-2" target="_blank"
                       href="<?= $escaper->escapeUrl($block->getImageUrl($author['image'], 'auth')) ?>">
                        <img class="w-24 h-24 rounded-full object-cover"
                             src="<?= $escaper->escapeUrl($block->getImageUrl($author['image'], 'auth')) ?>"
                             alt="<?= $escaper->escapeHtmlAttr($author['image']) ?>"/>
                    </a>
                <?php endif; ?>
                <input type="file" name="image" id="image" class="form-input w-full"
                       title="<?= $escaper->escapeHtmlAttr(__('Avatar')) ?>"/>
                <?php if (!empty($author['image'])): ?>
                    <label class="field choice mt-2" for="post_image_delete">
                        <input type="checkbox" name="image[delete]" value="1" id="post_image_delete"/>
                        <span><?= $escaper->escapeHtml(__('Delete Image')) ?></span>
                    </label>
                <?php endif; ?>
            </div>
        </div>

        <div class="field">
            <label class="label" for="url_key"><span><?= $escaper->escapeHtml(__('URL Key')) ?></span></label>
            <div class="control">
                <input type="text" name="url_key" id="url_key" class="form-input w-full"
                       value="<?= $escaper->escapeHtmlAttr($author['url_key']) ?>"
                       title="<?= $escaper->escapeHtmlAttr(__('URL Key')) ?>"/>
                <p class="mt-1 text-sm text-gray-500">
                    <?= $escaper->escapeHtml($block->getUrl('blog/author') . $author['url_key'] . $block->getUrlSuffix()) ?>
                </p>
            </div>
        </div>

        <div class="field">
            <label class="label" for="facebook_link"><span><?= $escaper->escapeHtml(__('Facebook Link')) ?></span></label>
            <div class="control">
                <input type="url" name="facebook_link" id="facebook_link" class="form-input w-full"
                       value="<?= $escaper->escapeHtmlAttr($author['facebook_link']) ?>"
                       title="<?= $escaper->escapeHtmlAttr(__('Facebook Link')) ?>"/>
            </div>
        </div>

        <div class="field">
            <label class="label" for="twitter_link"><span><?= $escaper->escapeHtml(__('Twitter Link')) ?></span></label>
            <div class="control">
                <input type="url" name="twitter_link" id="twitter_link" class="form-input w-full"
                       value="<?= $escaper->escapeHtmlAttr($author['twitter_link']) ?>"
                       title="<?= $escaper->escapeHtmlAttr(__('Twitter Link')) ?>"/>
            </div>
        </div>
    </fieldset>

    <div class="actions-toolbar">
        <div class="primary">
            <button type="submit" class="action submit primary btn btn-primary"
                    title="<?= $escaper->escapeHtmlAttr($submitTxt) ?>">
                <span><?= $escaper->escapeHtml($submitTxt) ?></span>
            </button>
        </div>
    </div>
</form>

<script>
    function initAuthorShortDescriptionEditor() {
        const shortDescriptionElement = document.getElementById('short_description');

        if (!shortDescriptionElement) {
            return;
        }

        if (!window.CKEDITOR || !window.CKEDITOR.ClassicEditor) {
            console.warn('CKEditor is not available for #short_description');
            return;
        }

        window.CKEDITOR.ClassicEditor.create(shortDescriptionElement, {
            toolbar: {
                items: [
                    'undo', 'redo', '|',
                    'heading', '|',
                    'bold', 'italic', 'strikethrough', 'underline', 'code', 'subscript', 'superscript', 'removeFormat', '|',
                    'bulletedList', 'numberedList', 'todoList', '|',
                    'alignment:left', 'alignment:right', 'alignment:center', 'alignment:justify', '|',
                    'blockQuote', '|',
                    'outdent', 'indent',
                ],
                shouldNotGroupWhenFull: true
            },
            list: {
                properties: {
                    styles: true,
                    startIndex: true,
                    reversed: true
                }
            },
            heading: {
                options: [
                    { model: 'paragraph', title: 'Paragraph', class: 'ck-heading_paragraph' },
                    { model: 'heading1', view: 'h1', title: 'Heading 1', class: 'ck-heading_heading1' },
                    { model: 'heading2', view: 'h2', title: 'Heading 2', class: 'ck-heading_heading2' },
                    { model: 'heading3', view: 'h3', title: 'Heading 3', class: 'ck-heading_heading3' },
                    { model: 'heading4', view: 'h4', title: 'Heading 4', class: 'ck-heading_heading4' },
                    { model: 'heading5', view: 'h5', title: 'Heading 5', class: 'ck-heading_heading5' },
                    { model: 'heading6', view: 'h6', title: 'Heading 6', class: 'ck-heading_heading6' }
                ]
            },
            placeholder: '',
            removePlugins: [
                'AIAssistant',
                'CKBox',
                'CKFinder',
                'EasyImage',
                'RealTimeCollaborativeComments',
                'RealTimeCollaborativeTrackChanges',
                'RealTimeCollaborativeRevisionHistory',
                'PresenceList',
                'Comments',
                'TrackChanges',
                'TrackChangesData',
                'RevisionHistory',
                'Pagination',
                'WProofreader',
                'MathType',
                'SlashCommand',
                'Template',
                'DocumentOutline',
                'FormatPainter',
                'TableOfContents',
                'PasteFromOfficeEnhanced'
            ]
        }).then(editor => {
            window.authorShortDescriptionEditor = editor;
        }).catch(err => {
            console.error(err.stack || err);
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initAuthorShortDescriptionEditor, { once: true });
    } else {
        initAuthorShortDescriptionEditor();
    }
</script>
<?php $hyvaCsp->registerInlineScript() ?>
