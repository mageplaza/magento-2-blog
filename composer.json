{
  "name": "mageplaza/magento-2-blog-extension",
  "description": "Magento 2 Blog extension",
  "require": {
    "mageplaza/module-core": "^1.6.0",
    "mageplaza/facebook-graph-sdk": "^1.0.2"
  },
  "type": "magento2-module",
  "version": "4.3.5",
  "license": "proprietary",
  "keywords": [
    "magento 2",
    "mageplaza",
    "blog",
    "magento 2 blog",
    "magento2"
  ],
  "authors": [
    {
      "name": "Mageplaza",
      "email": "support@mageplaza.com",
      "homepage": "https://www.mageplaza.com",
      "role": "Technical Support"
    }
  ],
  "autoload": {
    "files": [
      "registration.php"
    ],
    "psr-4": {
      "Mageplaza\\Blog\\": ""
    }
  },
  "require-dev": {
    "magento/magento-coding-standard": "^41",
    "phpstan/phpstan": "^2.1",
    "bitexpert/phpstan-magento": "^0.44",
    "phpstan/extension-installer": "^1.4"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  }
}
